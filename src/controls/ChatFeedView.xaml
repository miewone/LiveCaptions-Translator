<UserControl x:Class="LiveCaptionsTranslator.ChatFeedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LiveCaptionsTranslator"
             FontFamily="Segoe UI, Malgun Gothic" Foreground="#EEF4FA">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility" />
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent" Width="4" HorizontalAlignment="Center">
                            <Track x:Name="PART_Track" IsDirectionReversed="True"
                                   Orientation="{TemplateBinding Orientation}"
                                   Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                                   Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Opacity="0" Focusable="False" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb MinHeight="24" Background="#607E91">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="2" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Opacity="0" Focusable="False" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="ChatMessageTemplate">
            <Border Margin="0,0,0,12" Padding="10,3,0,3" BorderThickness="2,0,0,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="#344B5C" />
                        <Setter Property="Opacity" Value="0.85" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsStreaming}" Value="True">
                                <Setter Property="BorderBrush" Value="#52E0B0" />
                                <Setter Property="Opacity" Value="1" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,3,8,0">
                        <TextBlock Text="VOICE" FontSize="9" FontWeight="Bold" Foreground="#68CFD4" />
                        <TextBlock Text="{Binding TimeLabel}" FontSize="10" Foreground="#8B9AAA" Margin="0,3,0,0" />
                    </StackPanel>
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{Binding Translation}" TextWrapping="Wrap" Cursor="Hand"
                                   MouseLeftButtonDown="CopyMessage_Click" ToolTip="클릭하면 번역을 복사합니다"
                                   FontSize="{Binding TranslationFontSize, RelativeSource={RelativeSource AncestorType={x:Type local:ChatFeedView}}}"
                                   FontWeight="{Binding TranslationWeight, RelativeSource={RelativeSource AncestorType={x:Type local:ChatFeedView}}}"
                                   Foreground="{Binding TranslationBrush, RelativeSource={RelativeSource AncestorType={x:Type local:ChatFeedView}}}"
                                   Visibility="{Binding ShowTranslation, RelativeSource={RelativeSource AncestorType={x:Type local:ChatFeedView}}, Converter={StaticResource BoolVisibility}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Grid.Row" Value="0" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TranslationFirst, RelativeSource={RelativeSource AncestorType={x:Type local:ChatFeedView}}}" Value="False">
                                            <Setter Property="Grid.Row" Value="1" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding Source}" TextWrapping="Wrap" Cursor="Hand" Margin="0,4,0,2"
                                   MouseLeftButtonDown="CopyMessage_Click" ToolTip="클릭하면 원문을 복사합니다"
                                   FontSize="{Binding OriginalFontSize, RelativeSource={RelativeSource AncestorType={x:Type local:ChatFeedView}}}"
                                   Foreground="#9BAABB"
                                   Visibility="{Binding ShowOriginal, RelativeSource={RelativeSource AncestorType={x:Type local:ChatFeedView}}, Converter={StaticResource BoolVisibility}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Grid.Row" Value="1" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TranslationFirst, RelativeSource={RelativeSource AncestorType={x:Type local:ChatFeedView}}}" Value="False">
                                            <Setter Property="Grid.Row" Value="0" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <StackPanel Grid.Row="2"
                                    Visibility="{Binding ShowTranslation, RelativeSource={RelativeSource AncestorType={x:Type local:ChatFeedView}}, Converter={StaticResource BoolVisibility}}">
                            <StackPanel Margin="0,7,0,0" Visibility="{Binding HasReplies, Converter={StaticResource BoolVisibility}}">
                                <TextBlock Text="추천 답변 · 클릭하면 복사" FontSize="10" Foreground="#85A5B9" Margin="0,0,0,4" />
                                <ItemsControl ItemsSource="{Binding Replies}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="8,5" Margin="0,0,0,4" Background="#202F3A" CornerRadius="4"
                                                    Cursor="Hand" MouseLeftButtonDown="CopyReply_Click" ToolTip="상대방 언어의 답변을 복사합니다">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Foreground="#B4EADC" FontWeight="SemiBold"
                                                               FontSize="{Binding OriginalFontSize, RelativeSource={RelativeSource AncestorType={x:Type local:ChatFeedView}}}" />
                                                    <TextBlock Text="{Binding Meaning}" TextWrapping="Wrap" Foreground="#9BAABB" Margin="0,2,0,0"
                                                               FontSize="{Binding OriginalFontSize, RelativeSource={RelativeSource AncestorType={x:Type local:ChatFeedView}}}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <TextBlock Text="추천 답변을 받지 못했습니다." FontSize="10" Foreground="#85A5B9" Margin="0,5,0,0"
                                       Visibility="{Binding RepliesUnavailable, Converter={StaticResource BoolVisibility}}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
        <Style x:Key="ChatButton" TargetType="Button">
            <Setter Property="Foreground" Value="#D9E5ED" />
            <Setter Property="Background" Value="#263541" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer x:Name="ConversationScroll" Grid.Row="0" Margin="0,3,0,0"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      ScrollChanged="ConversationScroll_Changed" PanningMode="VerticalOnly">
            <Grid MinHeight="{Binding ViewportHeight, ElementName=ConversationScroll}">
            <StackPanel Margin="2,6,8,0" VerticalAlignment="Bottom">
                <ItemsControl ItemsSource="{Binding Messages}" ItemTemplate="{StaticResource ChatMessageTemplate}" />
                <ContentControl Content="{Binding LiveMessage}" ContentTemplate="{StaticResource ChatMessageTemplate}" />
            </StackPanel>
            </Grid>
        </ScrollViewer>
        <StackPanel Grid.Row="0" VerticalAlignment="Center" Margin="20"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolVisibility}}" IsHitTestVisible="False">
            <TextBlock Text="대화가 이곳에 쌓입니다" FontSize="18" FontWeight="SemiBold" Foreground="#DCE9F2" />
            <TextBlock Text="게임 소리가 들리면 원문이 먼저 표시되고 번역이 이어집니다.&#x0a;번역 엔진과 언어는 설정에서 선택하세요."
                       FontSize="12" Foreground="#91A2B5" TextWrapping="Wrap" Margin="0,8,0,0" />
        </StackPanel>
        <Button x:Name="LatestButton" Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,12,10" Content="최신 대화 ↓" Style="{StaticResource ChatButton}"
                Visibility="Collapsed" Click="LatestButton_Click" />
        <Border Grid.Row="1" BorderBrush="#304351" BorderThickness="0,1,0,0" Padding="2,8,2,2">
            <TextBlock Text="{Binding Status}" FontSize="11" TextWrapping="Wrap" ToolTip="{Binding Status}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="#85A5B9" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                <Setter Property="Foreground" Value="#E9BF78" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                <Setter Property="Foreground" Value="#FFAE9F" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>
    </Grid>
</UserControl>
