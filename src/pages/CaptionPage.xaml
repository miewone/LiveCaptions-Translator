<Page x:Class="LiveCaptionsTranslator.CaptionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:LiveCaptionsTranslator"
      Title="음성 채팅" JournalEntry.KeepAlive="True" Background="Transparent">
    <Border Margin="4,3,14,8" Background="#131D27" BorderBrush="#2B4050" BorderThickness="1" CornerRadius="8" Padding="16,12">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="VOICE CHAT" Foreground="#76D6CC" FontSize="11" FontWeight="Bold" />
                    <TextBlock Text="실시간 음성 번역" Foreground="#EDF5FA" FontSize="19" FontWeight="SemiBold" Margin="0,4,0,0" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="Ctrl + 휠  글자 크기" Foreground="#92A4B6" FontSize="11" VerticalAlignment="Bottom" />
            </Grid>
            <local:ChatFeedView x:Name="ChatView" Grid.Row="1" PreviewMouseWheel="ChatView_PreviewMouseWheel" />
        </Grid>
    </Border>
</Page>
